{
    "name": "arthurhoaro/rss-extender",
    "description": "Convert short abstract RSS feeds to full articles using this web tool",
    "keywords": ["rss", "atom", "extender", "abstract", "summary"],
    "homepage": "https://github.com/arthurhoaro/rss-extender",
    "license": "MIT",
    "authors": [
        {
            "name": "ArthurHoaro",
            "homepage": "https://hoa.ro"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^8.3",
        "monolog/monolog": "^3.12",
        "php-feed-io/feed-io": "^6.5",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "symfony/cache": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/dom-crawler": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "ArthurHoaro\\RssExtender\\": "src/"
        },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit"
    }
}
